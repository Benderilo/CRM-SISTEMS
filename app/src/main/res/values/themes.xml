<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.CRMSistems" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#1B5FD9</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#DCE6FF</item>
        <item name="colorOnPrimaryContainer">#001B4B</item>

        <item name="colorSecondary">#00875A</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#C6F2E1</item>
        <item name="colorOnSecondaryContainer">#00281A</item>

        <item name="colorTertiary">#7A5AF8</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#E7DEFF</item>
        <item name="colorOnTertiaryContainer">#22005D</item>

        <item name="colorError">#BA1A1A</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">#FFDAD6</item>
        <item name="colorOnErrorContainer">#410002</item>

        <item name="android:colorBackground">#F5F6FA</item>
        <item name="colorOnBackground">#191C22</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#191C22</item>
        <item name="colorSurfaceVariant">#E2E4EE</item>
        <item name="colorOnSurfaceVariant">#454A56</item>
        <item name="colorOutline">#767A87</item>
        <item name="colorOutlineVariant">#C6C9D4</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor" tools:targetApi="21">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@android:color/transparent</item>
    </style>

    <style name="Theme.CRMSistems" parent="Base.Theme.CRMSistems" />

    <!-- Заставка: всегда тёмная, чтобы неон не «моргал» на белом фоне при запуске -->
    <style name="Theme.CRMSistems.Splash" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/neon_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor" tools:targetApi="21">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/neon_background</item>
    </style>

    <!-- ================= Общие стили ================= -->

    <style name="Widget.Crm.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="TextAppearance.Crm.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Crm.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Crm.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <!-- Строка списка выбора (например, товара при добавлении позиции):
         карточка поверх сероватого фона диалога. Так позиции отделены друг от
         друга и не сливаются в сплошной столбец текста. -->
    <style name="Widget.Crm.PickCard" parent="Widget.Crm.Card">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="strokeWidth">1dp</item>
        <!-- Обводка светлее, чем у обычных карточек: диалог и так тесный,
             и без заметной рамки строки сливаются. -->
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="ShapeAppearance.Crm.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.Crm.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Кнопка звонка: зелёная и крупная — по заказу первым делом звонят,
         и попасть по ней надо с одного касания, не глядя. Цвет свой, а не
         из темы: он должен читаться как «звонок» в обеих темах. -->
    <style name="Widget.Crm.CallButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/call_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="icon">@drawable/ic_call</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">10dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Кнопка «Маршрут» рядом со звонком: тот же размер и форма, но синяя —
         чтобы не спутать с зелёным звонком. Строит маршрут до адреса в Яндекс Картах. -->
    <style name="Widget.Crm.MapButton" parent="Widget.Crm.CallButton">
        <item name="backgroundTint">@color/map_blue</item>
        <item name="icon">@drawable/ic_map_pin</item>
        <item name="iconPadding">6dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Widget.Crm.TextField.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
</resources>
