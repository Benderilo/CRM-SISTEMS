    <!-- Бот MAX -->
    <string name="nav_bot">Бот MAX</string>
    <string name="bot_title">Бот MAX</string>
    <string name="bot_section_token">Подключение</string>
    <string name="bot_token">Токен бота</string>
    <string name="bot_token_hint">Токен выдаёт @MasterBot в MAX при создании бота. Он хранится только на сервере.</string>
    <string name="bot_token_saved">Токен задан: %1$s. Чтобы заменить — впишите новый и сохраните.</string>
    <string name="bot_enabled">Бот включён</string>
    <string name="bot_call_words">Слова-обращения в группе</string>
    <string name="bot_call_words_hint">Через запятую: бот, Маруся. В группе бот отвечает, только если в сообщении есть одно из этих слов (падежи понимает: «Марусе, каталог»). В личном чате обращение не нужно.</string>
    <string name="bot_section_restart">Перезапуск</string>
    <string name="bot_restart_hint">MAX иногда перестаёт присылать сообщения: связь есть, ошибок нет, а бот молчит. Раз в сутки сервер поднимает опрос заново — это лечит такие зависания сам, без вашего участия. Переписка и корзины покупателей при этом не теряются. Время здесь московское — по нему живёт сервер.</string>
    <string name="bot_restart_daily">Перезапускать раз в сутки</string>
